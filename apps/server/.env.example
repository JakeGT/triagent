# The address people use to reach Triagent (scheme and host, no trailing slash).
PUBLIC_ORIGIN=https://code-review.example.com
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# Proxies in front that append to X-Forwarded-For (0: trust none).
PROXY_HOPS=1

# The key that encrypts stored secrets: 32 random bytes, base64 (`openssl rand -base64 32`).
# Prefer a file (Docker secret) over the variable. Keep a copy somewhere safe: without it, stored
# secrets can't be read and have to be entered again.
TRIAGENT_SECRETS_KEY_FILE=/run/secrets/triagent_secrets_key

# Postgres 15 or later, as a connection string (postgres://user:password@host:5432/database). It holds
# a password, so prefer a file (Docker secret) over the variable. Required in production; without it
# the server keeps everything in memory. Migrations run at start-up.
DATABASE_URL_FILE=/run/secrets/triagent_database_url
# Keep the tables in this schema instead of the database's default (usually public).
# DATABASE_SCHEMA=triagent

# How people sign in: local (usernames and passwords) or oidc (an identity provider such as Authentik).
# See docs/authentication.md.
AUTH_MODE=local

# AUTH_MODE=local: the first instance admin, created when there are no accounts yet. Remove after first start.
TRIAGENT_ADMIN_USER=
TRIAGENT_ADMIN_PASSWORD_FILE=/run/secrets/triagent_admin_password

# AUTH_MODE=oidc: the provider. Its redirect URI must be exactly PUBLIC_ORIGIN/auth/callback.
# OIDC_ISSUER=https://auth.example.com/application/o/triagent/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/triagent_oidc_client_secret
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Example        # the button: "Sign in with Example"
# OIDC_ADMIN_GROUP=platform-admin   # members are instance admins, checked at every sign-in
# Treat the provider's email addresses as verified even without email_verified: true. Only if people
# can't set their own address there (see docs/authentication.md).
# OIDC_TRUST_EMAIL=false
# Who gets an account on first sign-in: invite (an invite for their verified address, the admin group,
# or the very first account) or open (anyone the provider lets in).
# SIGNUP_MODE=invite
# Shown with invites and on "You need an invite", e.g. how to get onto the provider's allowlist.
# INVITE_HINT=Ask an administrator to add your Google address to the sign-in allowlist.

# Reviews run in a separate runner process (apps/runner), which uses this secret (the same value) to ask for
# work at /internal/runner. Never expose /internal/ through the reverse proxy.
TRIAGENT_RUNNER_SECRET_FILE=/run/secrets/triagent_runner_secret
# How many reviews may run at once on the instance, and in any one workspace (1 to 100). These are only the
# defaults: once an instance admin saves limits in Settings → Instance → Reviews, those apply instead, and
# changing these does nothing. Limits above what the runners can do (their RUNNER_CONCURRENCY, added up)
# change nothing either: reviews wait for a free runner slot.
# REVIEW_CONCURRENCY=1
# REVIEW_CONCURRENCY_PER_WORKSPACE=1
# GitHub Enterprise Server (default: github.com).
# GITHUB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Optional
# WEB_DIST_DIR=/app/web    # the built web app (default: apps/web/dist in the repository)
# DEFAULT_BRANCH=main
# REQUESTS_PER_MINUTE=600
# SESSION_IDLE_MINUTES=480
# SESSION_MAX_HOURS=72
# OPENROUTER_CATALOGUE=true # fetch OpenRouter's public model list (names and prices) for the model picker and default prices; false to never contact OpenRouter
# ALLOW_PRIVATE_MODEL_URLS=false # let custom and Azure model URLs point at private and loopback addresses (a self-hosted Ollama), with plain http to those only
# ALLOW_PRIVATE_GITHUB_URLS=false # let a workspace's GitHub Enterprise Server address point at private and loopback addresses, with plain http to those only
# TUTORIAL_AUTO_START=true # new accounts are shown the tutorial when they first sign in; false to start them with it done
# REAUTH_MINUTES=15        # changing secrets needs a sign-in at most this old

# Logs and error reporting (docs/logging.md)
# LOG_LEVEL=info           # debug, info, warn or error
# LOG_FORMAT=text          # text, or json for one JSON object a line
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>   # report errors and log lines to Sentry (or SENTRY_DSN_FILE); unset: nothing leaves the instance
# SENTRY_BROWSER_DSN=      # a project of its own for the web app (default: the same one)
# SENTRY_BROWSER=true      # false to leave the web app out
# SENTRY_LOGS=true         # false to send errors only
# SENTRY_TRACES_SAMPLE_RATE=0   # the share of requests to trace, 0 to 1
# SENTRY_ENVIRONMENT=production
