# The address people use to reach Triagent (scheme and host, no trailing slash).
PUBLIC_ORIGIN=https://code-review.example.com
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# Proxies in front that append to X-Forwarded-For (0: trust none).
PROXY_HOPS=1

# The key that encrypts stored secrets: 32 random bytes, base64 (`openssl rand -base64 32`).
# Prefer a file (Docker secret) over the variable. Keep a copy somewhere safe: without it, stored
# secrets can't be read and have to be entered again.
TRIAGENT_SECRETS_KEY_FILE=/run/secrets/triagent_secrets_key

# Postgres 15 or later, as a connection string (postgres://user:password@host:5432/database). It holds
# a password, so prefer a file (Docker secret) over the variable. Required in production; without it
# the server keeps everything in memory. Migrations run at start-up.
DATABASE_URL_FILE=/run/secrets/triagent_database_url
# Keep the tables in this schema instead of the database's default (usually public).
# DATABASE_SCHEMA=triagent

# The first instance admin, created when there are no accounts yet. Remove after first start.
TRIAGENT_ADMIN_USER=
TRIAGENT_ADMIN_PASSWORD_FILE=/run/secrets/triagent_admin_password

# Optional
# DEFAULT_BRANCH=main
# REQUESTS_PER_MINUTE=600
# SESSION_IDLE_MINUTES=480
# SESSION_MAX_HOURS=72
