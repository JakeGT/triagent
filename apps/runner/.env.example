# The Triagent server, on the private network the runner shares with it (never through the public proxy).
TRIAGENT_SERVER_URL=http://triagent:8080

# The secret shared with the server (the same TRIAGENT_RUNNER_SECRET). Prefer a file (Docker secret).
TRIAGENT_RUNNER_SECRET_FILE=/run/secrets/triagent_runner_secret

# How many reviews this runner works on at once: its slots. The server also caps reviews per instance and
# workspace (Settings → Instance → Reviews); whichever is lower wins.
RUNNER_CONCURRENCY=1

# Bare mirrors of the repositories it reviews, kept between runs so fetches are quick. Disposable: a tmpfs
# or an anonymous volume. Worktrees for each review go under RUNNER_WORK_DIR and are deleted afterwards.
# Several runners may share one cache volume: they take turns fetching into a repository's mirror. It
# must be writable (a review fails at once, saying so, if it isn't).
RUNNER_CACHE_DIR=/var/cache/triagent-runner
RUNNER_WORK_DIR=/tmp/triagent-runner

# Optional
# RUNNER_MODEL_PARALLELISM=5     # how many of one review's models run at once (each is an OCR process; the rest wait)
# RUNNER_OVER_BUDGET_GRACE_SECONDS=120  # a model past its token budget gets this long to finish by itself before it's stopped (0: at once)
# RUNNER_NAME=runner-1           # shown on the Runs page (default: the host name)
# RUNNER_POLL_SECONDS=3          # how often to ask for work when idle
# RUNNER_HEALTH_PORT=8081        # answer GET /healthz on 127.0.0.1 (for container health checks)
# OCR_BIN=ocr                    # the Open Code Review binary
# OCR_LLM_TIMEOUT=300            # passed to OCR: seconds to wait for one model reply
# LOG_LEVEL=info                 # debug, info, warn or error
# LOG_FORMAT=text                # text, or json for one JSON object a line
# RUNNER_RELAY_LOGS=true         # pass the runner's own log lines (never a review's) to the server, for its error tracker if it has one
