{
  "name": "triagent",
  "version": "0.0.0",
  "private": true,
  "description": "Automated Open Code Review runs on GitHub pull requests, with a triage board shared by people and AI agents",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test --test-reporter=spec \"apps/*/test/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:legacy": "TRIAGENT_CONTRACT_TARGET=legacy node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:v1": "TRIAGENT_CONTRACT_TARGET=v1 node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "build:web": "pnpm --filter @triagent/web build",
    "test:web": "pnpm --filter @triagent/web test",
    "test:e2e": "pnpm build:web && pnpm --filter @triagent/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
